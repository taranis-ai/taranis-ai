COMPOSE_PROJECT_NAME=taranis
TARANIS_TAG=latest
DOCKER_IMAGE_NAMESPACE=ghcr.io/taranis-ai

TARANIS_PORT=8080
GRANIAN_PORT=8080
TARANIS_BASE_PATH=/
DISABLE_HTTP3=False

# Use a unique suffix such as _q when multiple deployments share one domain.
JWT_COOKIE_SUFFIX=

# Default passwords. CHANGE THESE FOR PRODUCTION!
POSTGRES_PASSWORD=supersecret
JWT_SECRET_KEY=supersecret
API_KEY=supersecret
BOT_API_KEY=supersecret
REDIS_PASSWORD=supersecret

# Realtime delivery uses independent credentials. Do not reuse API_KEY or JWT_SECRET_KEY.
REALTIME_ENABLED=false
CENTRIFUGO_API_URL=http://centrifugo:9000
CENTRIFUGO_API_KEY=change-me-centrifugo-api-key
CENTRIFUGO_CONNECT_PROXY_SECRET=change-me-centrifugo-connect-proxy-secret
CENTRIFUGO_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:8080

# Optional llm-bot settings for summary, title generation, NER, story clustering, sentiment and cybersecurity classification.
# LLM_BASE_URL example: http://localhost:11434/v1
# LLM_API_KEY example: <provider_api_key>
# LLM_MODEL examples: llama2, gpt-4, etc.
# LLM_TIMEOUT is in seconds.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_BOT_PORT=8000
# TITLE_API_ENDPOINT=http://llm-bot:8000/title
# SENTIMENT_ANALYSIS_API_ENDPOINT=http://llm-bot:8000/sentiment
# CYBERSEC_CLASSIFIER_API_ENDPOINT=http://llm-bot:8000/cybersec-classification

# Optional analyst Chat using OpenRouter's free-model router.
# Create an API key at https://openrouter.ai/keys, then set CHAT_ENABLED=true.
# Analyst prompts and selected story summaries are sent to OpenRouter.
CHAT_ENABLED=false
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_MODEL=openrouter/free
CHAT_LLM_API_KEY=
# CHAT_LLM_TIMEOUT=120
# CHAT_MAX_STORIES=5
# CHAT_REQUEST_TIMEOUT=300

# Optional dedicated frontend cache settings. When unset, frontend/core fall back to REDIS_URL and REDIS_PASSWORD.
# CACHE_ENABLED=true
# CACHE_REDIS_URL=redis://redis:6379/0
# CACHE_REDIS_PASSWORD=supersecret
