COMPOSE_PROJECT_NAME=taranis
TARANIS_TAG=latest
DOCKER_IMAGE_NAMESPACE=ghcr.io/taranis-ai

TARANIS_PORT=8080
GRANIAN_PORT=8080

# Default passwords. CHANGE THESE FOR PRODUCTION!
POSTGRES_PASSWORD=supersecret
JWT_SECRET_KEY=supersecret
API_KEY=supersecret
BOT_API_KEY=supersecret
REDIS_PASSWORD=supersecret

# Optional llm-bot settings for summary, NER and story clustering.
# LLM_BASE_URL example: http://localhost:11434/v1
# LLM_API_KEY example: <provider_api_key>
# LLM_MODEL examples: llama2, gpt-4, etc.
# LLM_TIMEOUT is in seconds.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_BOT_PORT=8000

# Optional analyst Chat using OpenRouter's free-model router.
# Create an API key at https://openrouter.ai/keys, then set CHAT_ENABLED=true.
# Analyst prompts and selected story summaries are sent to OpenRouter.
CHAT_ENABLED=false
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_MODEL=openrouter/free
CHAT_LLM_API_KEY=
# CHAT_LLM_TIMEOUT=120
# CHAT_MAX_STORIES=5
# CHAT_REQUEST_TIMEOUT=300

# Optional dedicated frontend cache settings. When unset, frontend/core fall back to REDIS_URL and REDIS_PASSWORD.
# CACHE_ENABLED=true
# CACHE_REDIS_URL=redis://redis:6379/0
# CACHE_REDIS_PASSWORD=supersecret
