          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="Colors: blue = Core services · yellow = worker / RQ · orange = model inference · purple = stores · red = authorization / recovery · green = frontend · gray = notes. Paths are repository-relative. Dashed arrows show recovery or configuration." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1695" height="65" />
        </mxCell>
      </root>
