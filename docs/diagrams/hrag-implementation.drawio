  </diagram>
  <diagram id="page-4" name="4 · HRAG question to answer">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="&lt;b&gt;4 · HRAG question to answer&lt;/b&gt;&lt;br&gt;Graph then vector execute sequentially in retrieve(); there is no cross-branch score fusion or reranker." style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="1720" height="90" />
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;R1 · Existing Chat turn entry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/frontend/frontend/views/chat_views.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/api/chat.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/chat.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;mode=hrag → create_turn() / _create_turn().&lt;br&gt;Owner check, Redis lease, shared deadline.&lt;br&gt;Context: last 10 messages, timezone/time, visible filter catalog, recent results, question." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;R2 · Constrained graph plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/models/models/hrag.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;prepare_retrieval_plan(context, GraphPlan).&lt;br&gt;Names, entity types, relationships, hops 0..3, Assess filters.&lt;br&gt;Validate filters using ChatService search helpers.&lt;br&gt;Planning failure leaves vector branch unfiltered + notice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;R3 · Authorized graph candidates&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;iter_authorized_work(extraction, filters).&lt;br&gt;Story.visible_query + NewsItem.allowed_with_acl().&lt;br&gt;Active generation, ready work, nonblank input, current fingerprint.&lt;br&gt;Pass allowed graph keys to graph_search()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;R4 · Fixed graph traversal&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;compile_graph(): hops=0 mentions; otherwise 1..3 undirected traversal.&lt;br&gt;All support edges must be allowed.&lt;br&gt;Multi-hop: affirmed only, excludes ALIAS_OF.&lt;br&gt;Stable bounded evidence; default ≤50 graph rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="R5" value="&lt;b&gt;R5 · Query embedding + vector top-k&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Embed latest_message; explicitly request active generation dimensions.&lt;br&gt;Authorize embedding work with the same planned filters.&lt;br&gt;Exact cosine ORDER BY distance, work_id; default 12.&lt;br&gt;Recheck generation and query dimensions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="R6" value="&lt;b&gt;R6 · Reconstruct and reauthorize&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/models/models/hrag.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Graph [G1…] and vector [V1…] references.&lt;br&gt;Reauthorize full path support_ids; reconstruct passages.&lt;br&gt;Append branches in one HragResult with notices/filters.&lt;br&gt;One failure → partial evidence; two → fail turn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="R7" value="&lt;b&gt;R7 · Synthesize with existing ChatClient&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/chat.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Reauthorize immediately before synthesis.&lt;br&gt;llm-bot SYNTHESIS_PROMPT + history/question/evidence.&lt;br&gt;Chat provider streams answer.&lt;br&gt;Successful empty retrieval → static insufficient-evidence answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="R8" value="&lt;b&gt;R8 · Freshness check and atomic save&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/chat.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/model/hrag.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Recheck current references + inherited history dependencies.&lt;br&gt;Persist both messages with HRAG references/dependencies.&lt;br&gt;Provider/retrieval failure prevents saving the message pair.&lt;br&gt;Final response reconstructs current evidence again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="R9" value="&lt;b&gt;R9 · Evidence panels and Assess links&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/frontend/frontend/views/chat_views.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/frontend/frontend/templates/chat/workspace.html&lt;/font&gt;&lt;br&gt;&lt;br&gt;Escaped answer text, graph evidence and similar passages.&lt;br&gt;Quotes, relation polarity, source title, truncation notice.&lt;br&gt;Current story_id produces an Assess navigation link.&lt;br&gt;Reload follows page 5 authorization flow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="e0" value="context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R1" target="R2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="validated plan + filters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R2" target="R3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="authorized keys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R3" target="R4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="graph references collected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R4" target="R5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="authorized vector matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R5" target="R6">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="HragResult" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R6" target="R7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="streamed answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R7" target="R8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="conversation detail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R8" target="R9">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="Colors: blue = Core services · yellow = worker / RQ · orange = model inference · purple = stores · red = authorization / recovery · green = frontend · gray = notes. Paths are repository-relative. Dashed arrows show recovery or configuration." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1695" height="65" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-5" name="5 · History, permissions and operations">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="&lt;b&gt;5 · History, permissions and operations&lt;/b&gt;&lt;br&gt;Authorization depends on live PostgreSQL sources and work state; graph cleanup is best effort." style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="1720" height="90" />
        </mxCell>
        <mxCell id="S1" value="&lt;b&gt;S1 · Reload or build provider history&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/chat.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;_conversation_detail() loads HragMessage metadata.&lt;br&gt;_history_payload() reuses that checked detail.&lt;br&gt;Last 10 saved messages form provider context.&lt;br&gt;A withheld answer becomes a static placeholder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="S2" value="&lt;b&gt;S2 · Reauthorize every reference&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;display_result() → reauthorize().&lt;br&gt;Re-fetch user + ASSESS_ACCESS; allowed source rows;&lt;br&gt;active generation; ready work; fresh fingerprint.&lt;br&gt;Every support_ids entry must be authorized." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="S3" value="&lt;b&gt;S3 · Protect derived conversation answers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/chat.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;_history_dependencies() gathers references + inherited dependencies.&lt;br&gt;Later Chat and HRAG turns persist dependency references.&lt;br&gt;If any dependency disappears, withhold the answer on reload and from later provider context." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="140" width="500" height="270" />
        </mxCell>
        <mxCell id="S4" value="&lt;b&gt;S4 · Admin index actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/api/settings.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/indexing.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;ADMIN_OPERATIONS on /api/settings/hrag.&lt;br&gt;GET: generation work counts (optional item IDs).&lt;br&gt;POST: backfill/reconcile, activate, reprocess.&lt;br&gt;Reprocess invalidates saved results and incurs inference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="S5" value="&lt;b&gt;S5 · Generation activation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/indexing.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/model/hrag.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Initial generation is active during first backfill.&lt;br&gt;Changed config creates an inactive generation.&lt;br&gt;activate(): scanned + every current item ready/fresh.&lt;br&gt;Switch only that pipeline; old generations remain stored." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="S6" value="&lt;b&gt;S6 · Recovery boundaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/indexing.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;PostgreSQL backup includes work/results/vectors/references.&lt;br&gt;Empty Neo4j rebuilds from stored extraction JSON.&lt;br&gt;Redis loss recovers via leases + reconciliation.&lt;br&gt;Dedicated Neo4j database required: pruning is global to HRAG labels." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="500" width="500" height="270" />
        </mxCell>
        <mxCell id="S7" value="&lt;b&gt;S7 · Evidence meaning and limitations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/models/models/hrag.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Exact quote validation proves provenance, not factual correctness.&lt;br&gt;Same-name entities stay separate except validated CVEs.&lt;br&gt;Undirected traversal does not reverse semantic relation direction.&lt;br&gt;Counts describe retrieved accessible indexed evidence only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="S8" value="&lt;b&gt;S8 · Tests to read&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/tests/unit/test_hrag_indexing.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/tests/unit/test_hrag_contracts.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/tests/integration/test_hrag_stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Lifecycle/cutoffs/retries/generations; provenance/identity;&lt;br&gt;real-store graph paths and filtered vector ranking.&lt;br&gt;Chat, RBAC, worker and browser suites cover integration; see guide for paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="S9" value="&lt;b&gt;S9 · Source reading map&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/indexing.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/retrieval.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;src/core/core/service/hrag/stores.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;Start: shared models/hrag.py → indexing.py → worker/hrag.py → stores.py → retrieval.py → service/chat.py.&lt;br&gt;The companion guide follows the same node IDs.&lt;br&gt;Existing deployment instructions: docs/features/hrag.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="860" width="500" height="270" />
        </mxCell>
        <mxCell id="e0" value="saved references + filters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S1" target="S2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="checked evidence + dependencies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S2" target="S3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="activate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S4" target="S5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="rebuild state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="S6" target="S5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="interpret checked evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="S7" target="S2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="Colors: blue = Core services · yellow = worker / RQ · orange = model inference · purple = stores · red = authorization / recovery · green = frontend · gray = notes. Paths are repository-relative. Dashed arrows show recovery or configuration." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1695" height="65" />
        </mxCell>
      </root>
