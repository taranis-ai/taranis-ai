PATH="$PATH:$HOME/.local/bin"

COMPOSE_PROJECT_NAME=taranis
TARANIS_TAG=latest
DOCKER_IMAGE_NAMESPACE=ghcr.io/taranis-ai

TARANIS_CORE_URL="http://local.taranis.ai/api"

JWT_COOKIE_SECURE=False
DEBUG=True

GRANIAN_PORT=8080
GRANIAN_HOST=0.0.0.0
GRANIAN_INTERFACE=wsgi
GRANIAN_APP=run
GRANIAN_LOG_LEVEL=debug
REALTIME_ENABLED=True
CENTRIFUGO_API_URL=http://localhost:9000
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_CONNECT_PROXY_SECRET=dev-centrifugo-connect-proxy-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://local.taranis.ai
TARANIS_REDIS_PORT=6379
