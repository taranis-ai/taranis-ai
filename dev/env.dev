PATH="$PATH:$HOME/.local/bin"

COMPOSE_PROJECT_NAME=taranis
TARANIS_TAG=latest
DOCKER_IMAGE_NAMESPACE=ghcr.io/taranis-ai

TARANIS_CORE_URL="http://local.taranis.ai/api"

DEBUG=True

GRANIAN_PORT=8080
GRANIAN_HOST=0.0.0.0
GRANIAN_INTERFACE=wsgi
GRANIAN_APP=run
GRANIAN_LOG_LEVEL=debug
# Optional analyst Chat; configure the provider in Admin Settings > Chat.
CHAT_ENABLED=False
REALTIME_ENABLED=True
CENTRIFUGO_API_URL=http://localhost:9000
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_CONNECT_PROXY_SECRET=dev-centrifugo-connect-proxy-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://local.taranis.ai
TARANIS_REDIS_PORT=6379

# Local inference; preserve an existing default configured in Admin Settings.
DEFAULT_LLM_ENDPOINT='{"name":"Bundled inference","base_url":"http://localhost:8000/v1","model":"unsloth/gemma-4-E4B-it-GGUF","api_format":"chat_completions","timeout":120}'
