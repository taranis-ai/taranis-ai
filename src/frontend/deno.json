{
  "nodeModulesDir": "auto",
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@4.3.0",
    "alpinejs": "npm:alpinejs@^3.17.1",
    "choices.js": "npm:choices.js@^11.2.4",
    "driver.js": "npm:driver.js@^1.8.0",
    "daisyui": "npm:daisyui@^5.7.27",
    "fuse.js": "npm:fuse.js@^7.5.0",
    "highlight-search-term": "npm:highlight-search-term@^1.0.3",
    "htmx.org": "npm:htmx.org@^4.0.0",
    "sortablejs": "npm:sortablejs@^1.15.7",
    "sweetalert2": "npm:sweetalert2@^11.26.25",
    "tailwindcss": "npm:tailwindcss@4.3.0",
    "@codemirror/state": "npm:@codemirror/state@^6.7.2",
    "@codemirror/view": "npm:@codemirror/view@^6.43.10",
    "@codemirror/commands": "npm:@codemirror/commands@^6.11.0",
    "@codemirror/language": "npm:@codemirror/language@^6.12.4",
    "@codemirror/legacy-modes": "npm:@codemirror/legacy-modes@^6.5.4",
    "@codemirror/merge": "npm:@codemirror/merge@^6.12.2",
    "codemirror": "npm:codemirror@^6.0.2"
  },
  "tasks": {
    "tw:build": "deno run -A npm:@tailwindcss/cli@4.3.0 -i frontend/static/css/input.css -o frontend/static/css/tailwind.css --minify",
    "tw:watch": "deno run -A npm:@tailwindcss/cli@4.3.0 -i frontend/static/css/input.css -o frontend/static/css/tailwind.css --watch",
    "vendor:bundle": "deno bundle --sourcemap=inline --platform=browser --minify --output frontend/static/vendor/vendor.bundle.js vendor.js",
    "vendor:bundle:codemirror": "deno bundle --sourcemap=inline --platform=browser --minify --output frontend/static/vendor/codemirror.js vendor_codemirror.js"
  }
}
